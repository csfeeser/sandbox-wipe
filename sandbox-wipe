#!/usr/bin/env bash
# Launcher: sets up a private Python environment on first run, then runs the tool.
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
VENV="$HERE/.venv"
if [ ! -x "$VENV/bin/python" ] || ! "$VENV/bin/python" -c 'import boto3' 2>/dev/null; then
  command -v python3 >/dev/null || { echo "python3 (3.9 or newer) is required. Install it, then run again." >&2; exit 1; }
  echo "First run: setting up (installing boto3 into $VENV) - this needs internet and takes about a minute..." >&2
  python3 -m venv "$VENV" && "$VENV/bin/pip" install -q -r "$HERE/requirements.txt" \
    || { echo "Setup failed. Check your internet connection and that python3-venv is installed." >&2; exit 1; }
fi
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python" -m sandbox_wipe "$@"
